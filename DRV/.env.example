# Decentralized Record Verifier — Environment Variables
# Copy this file to .env and fill in values. Never commit .env.

# --- Blockchain ---
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
SIGNER_PRIVATE_KEY=

# --- Model ---
MODEL_NAME=qwen2.5:3b-instruct
MODEL_ENDPOINT=http://localhost:11434
NLP_RETRY_ON_INVALID=false

# --- Validation ---
ID_PATTERN=^[A-Z]{2,6}-[0-9]{1,8}$

# --- Uploads ---
MAX_UPLOAD_MB=5

# --- Admin ---
ADMIN_CREDENTIALS_HASH=

# --- Database ---
DB_PATH=data/verifier.db

# --- Operations ---
LOG_LEVEL=INFO

